{
  "type": "object",
  "properties": {
    "customer": {
      "type": ["string", "null"],
      "description": "客户列表中最匹配的准确客户名称，没有把握为 null"
    },
    "customer_phrase": {
      "type": ["string", "null"],
      "description": "口述中指代客户的原话片段，如“一杯”“万杯”"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_code": {"type": "string", "description": "商品货号"},
          "qty": {"type": "number", "description": "数量（瓶）"},
          "phrase": {"type": "string", "description": "口述中指代该商品的原话片段，如“jiji”“丹魄”"}
        },
        "required": ["item_code", "qty", "phrase"],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": ["string", "null"],
      "description": "不确定或需要用户确认的地方，没有为 null"
    },
    "shipping_rule": {
      "type": ["string", "null"],
      "description": "物流方式列表中最匹配的一项，没提到为 null"
    },
    "freight": {
      "type": ["number", "null"],
      "description": "口述的运费金额（元），没提到为 null"
    }
  },
  "required": ["customer", "customer_phrase", "items", "notes",
               "shipping_rule", "freight"],
  "additionalProperties": false
}
